{
  "name": "dsh-zterm",
  "version": "0.1.18",
  "description": "zTerm：SSH、JumpServer、真实机器读工具与人类开启的读写操作",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhanfei-ai/dsh-zterm.git"
  },
  "homepage": "https://github.com/guhanfei-ai/dsh-zterm#readme",
  "bugs": "https://github.com/guhanfei-ai/dsh-zterm/issues",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "USERGUIDE.zh-CN.md",
    "scripts/prepare-native.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:package": "node scripts/check-package.mjs",
    "postinstall": "node scripts/prepare-native.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@sinclair/typebox": "0.34.41",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/xterm": "5.5.0",
    "ssh2": "1.17.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-alpha.0 || ^0.2.1-alpha.0",
    "dsh-better-sidebar": ">=0.24.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.0",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
